        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/TestDm/seed-user": {
      "post": {
        "tags": [
          "TestDm"
        ],
        "parameters": [
          {
            "name": "UserName",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "testAdmin2"
            }
          },
          {
            "name": "OverWrite",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateAccountRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "age": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      }
    }
  },
